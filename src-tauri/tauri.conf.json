{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitFolio",
  "version": "0.3.7",
  "identifier": "dev.litera.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LitFolio",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0a0a0f",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* asset: http://asset.localhost; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Litera-Library/**", "$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../docs/manual/manual.pdf",
      "../docs/manual/manual-en.pdf"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first literature manager with LLM summaries",
    "longDescription": "LitFolio is a desktop literature management app with LLM-powered TL;DR, structured extraction, smart tagging, RAG Q&A, RSS subscriptions and Markdown notes."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNDNCNDlDNkM5MDgwQjQKUldTMGdKQnNuTFJEUTJBNnhKOGU3dElUVUlkYjE3SkpDNFRSeStJdnlLeXFhVHZ5elhLaGd6Si8K",
      "endpoints": [
        "https://github.com/lychen2/LitFolio/releases/latest/download/latest.json"
      ]
    },
    "shell": {
      "open": true
    }
  }
}
